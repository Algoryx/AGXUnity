SignalScene is Physics3D.System:
  body is Physics3D.Bodies.RigidBody:
    geometry is Physics3D.Geometries.Box:
      size: Math.Vec3.from_xyz(0.1, 0.1, 0.1)
    connector is Physics3D.Interactions.MateConnector

  world_connector is Physics3D.Interactions.MateConnector

  hinge is Physics3D.Interactions.Hinge:
    connectors: [world_connector, body.connector]

  motor is Physics3D.Interactions.RotationalVelocityMotor:
    connectors: hinge.connectors
    target_speed: 0

  motor_speed is Physics.Signals.AngularVelocity1DInput:
    source: motor
